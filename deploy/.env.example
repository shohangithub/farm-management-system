# =============================================================================
# Farm360 — production environment for docker-compose.prod.yml
#   cp deploy/.env.example deploy/.env   (deploy/.env is git-ignored — never commit it)
#   docker compose --env-file deploy/.env -f docker-compose.prod.yml up -d
# Every value marked REQUIRED has no default; compose refuses to start without it.
# =============================================================================

# ── Images (CI pushes ghcr.io/<owner>/<repo>/farm360-api:<sha> etc.) ─────────
FARM360_API_IMAGE=farm360-api:latest
FARM360_WEB_IMAGE=farm360-web:latest
FARM360_MIGRATOR_IMAGE=farm360-migrator:latest

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
# Use a dedicated least-privilege login (db_datareader/db_datawriter/db_ddladmin for migrations), not sa.
# Bundled SQL Server (--profile bundled-db): Server=sqlserver,1433;...
FARM360_DB_CONNECTION=Server=sqlserver,1433;Database=Farm360;User Id=farm360_app;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;
# Only with --profile bundled-db
MSSQL_SA_PASSWORD=
MSSQL_PID=Express

# ── Redis (REQUIRED) ──────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Auth (REQUIRED) — at least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
JWT_ISSUER=https://auth.farm360.ai
JWT_AUDIENCE=https://api.farm360.ai

# ── Public URLs (REQUIRED) ────────────────────────────────────────────────────
PUBLIC_WEB_ORIGIN=https://app.example.com
# Only if the API is served from a different origin than the SPA
PUBLIC_API_BASE_URL=

# ── Payments — SSLCommerz LIVE store (REQUIRED) ───────────────────────────────
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=false

# ── Messaging (REQUIRED for real OTP / password reset / invitations) ─────────
# SMS_PROVIDER: Log (sends nothing) | BulkSmsBd (bulksmsbd.net)
SMS_PROVIDER=BulkSmsBd
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=
# EMAIL_PROVIDER: Log | Smtp (any SMTP relay: Brevo, Amazon SES SMTP, Mailgun, Google Workspace)
EMAIL_PROVIDER=Smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Farm360

# ── First platform admin (optional; created once if set, then remove) ────────
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# ── Hosting ───────────────────────────────────────────────────────────────────
WEB_BIND=127.0.0.1
WEB_PORT=8080
TRUSTED_PROXY_NETWORK=172.16.0.0/12
HANGFIRE_RUN_SERVER=true
HANGFIRE_WORKER_COUNT=4

# ── Observability (optional) ──────────────────────────────────────────────────
SEQ_SERVER_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
