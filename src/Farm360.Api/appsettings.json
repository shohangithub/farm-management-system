{
  // =============================================================================
  // Farm360 AI — appsettings.json
  // BASE configuration — applies to all environments.
  // Secrets (passwords, keys) are NEVER in this file.
  // Secrets strategy:
  //   Development: User Secrets (dotnet user-secrets)
  //   Production:  AWS Parameter Store / Secrets Manager
  // =============================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "ConnectionStrings": {
    // SQL Server 2022 — matches docker-compose.yml service name
    "DefaultConnection": "Server=103.125.255.14,9436;Database=farm360_prod;User Id=sylhetcoldstorage.com;Password=Sa1234!;TrustServerCertificate=True;MultipleActiveResultSets=True;",

    // Redis — matches docker-compose.yml service
    "Redis": "localhost:6379,password=Farm360Redis2026,ssl=false,abortConnect=false"
  },
  // Serilog configuration — Constitution §11
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Seq": {
      "ServerUrl": ""
    }
  },

  // JWT — F360-AUTH-2026-001 §2.2
  // NEVER put SecretKey here — use User Secrets or AWS Parameter Store
  "Jwt": {
    "Secret": "Farm360-Dev-Secret-Key-Must-Be-At-Least-256-Bits-Long-For-HS256!",
    "Issuer": "https://auth.farm360.ai",
    "Audience": "https://api.farm360.ai",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30,
    "DeviceTokenExpiryDays": 90
  },

  // CORS — allowed Angular client origins
  "Cors": {
    "AllowedOrigins": [
      "https://farm.devance.net"
    ]
  },

  // API versioning
  "Api": {
    "Version": "v1",
    "Title": "Farm360 AI API",
    "Description": "Enterprise Livestock Management Platform"
  },

  // Multi-tenant defaults — F360-MTA-2026-001
  "MultiTenant": {
    "TenantCacheTtlMinutes": 5,
    "MaxSessionsPerTier": {
      "Bittho": 2,
      "Khamar": 5,
      "Banik": 10,
      "Corp": 999
    }
  },

  // OTP configuration — F360-AUTH-2026-001 §2.1
  "Otp": {
    "ExpiryMinutes": 10,
    "MaxAttempts": 3,
    "LockoutMinutes": 30,
    "RateLimitPerHour": 5,
    "Length": 6
  },

  // Hangfire — background jobs
  "Hangfire": {
    "DashboardEnabled": false,
    "WorkerCount": 4
  },

  // File storage
  "Storage": {
    "Provider": "AwsS3",
    "BucketName": "farm360-uploads",
    "MaxFileSizeMb": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".pdf" ]
  },

  // Health check
  "HealthCheck": {
    "Enabled": true,
    "Path": "/health"
  },

  // Performance thresholds — Constitution §20
  "Performance": {
    "SlowRequestWarningMs": 500,
    "SlowRequestCriticalMs": 2000,
    "CacheDefaultTtlMinutes": 5
  },

  // Feature flags (MVP defaults)
  // =============================================================================
  // Business rules — the farm's configurable assumptions (docs/33).
  // These are business judgements, not technical constants. Changing a value here
  // changes FUTURE calculations only: feed allocations store the method that produced
  // them, so historical reports keep reprinting the numbers they were signed off with.
  // =============================================================================
  "Farm360": {
    "BusinessRules": {
      // How shared feed is divided between animals on a batch/shed/pen plan.
      // MetabolicWeight (default) | EqualPerHead | LiveWeight
      "FeedAllocation": "MetabolicWeight",
      "MetabolicWeightExponent": 0.75,

      // What a group plan's rule-line quantity means.
      // PerHead (default — Farm360 rule lines are per-animal rations) | WholeGroup
      "GroupPlanQuantityBasis": "PerHead",

      // Assumed weight for an unweighed animal, so it cannot take a zero share.
      "FallbackAnimalWeightKg": 150,

      // How labour and overhead are pushed onto individual animals.
      // PerHeadDay (default) | PerLiveWeight
      "OverheadAllocation": "PerHeadDay",

      // What period a farm-level expense covers. A monthly wage bill is earned across the
      // month, not on the day it was posted. CalendarMonth (default) | TransactionDate
      "OverheadCostPeriod": "CalendarMonth",

      // How an animal's current value is established.
      // MeatYieldMarket (default) | LiveWeightMarket | CostBasis
      "Valuation": "MeatYieldMarket",
      "DefaultDressingPercentage": 0.50,
      "DefaultMeatPricePerKgBdt": 680,
      "DefaultLiveWeightPricePerKgBdt": 400,

      // Report presentation. English | Bangla
      "DefaultReportLanguage": "English",
      "BengaliNumeralsByDefault": false,

      // QuestPDF licence tier. Community is free ONLY while annual revenue is below
      // USD 1M — confirm before relying on it. Community | Professional | Enterprise
      "PdfLicence": "Community",
      "PdfLicenceKey": null
    }
  },

  "FeatureFlags": {
    "EnableSocialLogin": false,
    "EnableTwoFactorAuth": false,
    "EnableMicrosoftEntraId": false,
    "EnableAiRecommendations": false,
    "EnableBulkSmsNotifications": true,
    "EnableEmailNotifications": false
  }
}
