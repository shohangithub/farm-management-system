{
  // =============================================================================
  // Farm360 AI — appsettings.Production.json
  // NON-SECRET production defaults only. Every secret (connection strings, Jwt:Secret, Redis
  // password, SSLCommerz store credentials, seed admin) comes from environment variables, e.g.
  //   ConnectionStrings__DefaultConnection, ConnectionStrings__Redis, Jwt__Secret,
  //   SslCommerz__StoreId, SslCommerz__StorePassword, Seed__SystemAdmin__Phone/Password.
  // Environment variables override this file (see README → Configuration).
  // Secret keys are deliberately NOT listed here with empty values: an empty value in this file
  // would override appsettings.json and blank the setting.
  // =============================================================================

  // Startup behaviour — apply migrations with the efbundle as a deploy step, not at app start.
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "DemoData": false
  },
  "Maintenance": {
    "RunFeedAllocationBackfillOnStartup": false
  },

  // Memory keeps the existing single-instance (shared hosting, no Redis) deployment working:
  // appsettings.json carries a localhost Redis string that is not reachable there.
  // Container / multi-instance deployments MUST set Cache__Provider=Redis (docker-compose.prod.yml does).
  // Auto = Redis when ConnectionStrings:Redis is set.
  "Cache": {
    "Provider": "Memory"
  },

  // Set RunServer=false on API replicas when a dedicated worker instance processes jobs.
  "Hangfire": {
    "RunServer": true,
    "WorkerCount": 4
  },

  // Proxies allowed to set X-Forwarded-For/Proto (IPs and CIDRs), e.g.
  //   ForwardedHeaders__KnownNetworks__0=10.0.0.0/8
  "ForwardedHeaders": {
    "Enabled": false,
    "ForwardLimit": 1
  },

  // Shared key ring: a path on a volume/file share. Leave empty to use Redis (when configured).
  "DataProtection": {
    "KeysPath": ""
  },

  // OTLP collector, e.g. http://otel-collector:4317. Empty = no export.
  "OpenTelemetry": {
    "Endpoint": "",
    "Protocol": "grpc",
    "ServiceName": "farm360-api"
  },

  "Serilog": {
    "Console": { "Json": false },
    "File": { "Enabled": true, "Directory": "logs" }
  }
}
