version = 1
root = true

# =============================================================================
# Farm360 AI — .editorconfig
# Enforces Constitution §3 (Coding Standards) §4 (Naming Standards)
# =============================================================================

[*]
charset                  = utf-8
end_of_line              = crlf
indent_style             = space
indent_size              = 4
tab_width                = 4
trim_trailing_whitespace = true
insert_final_newline     = true
max_line_length          = 120

# C# files
[*.cs]
indent_size                                                      = 4

# Naming: Interfaces — Constitution §4.1
dotnet_naming_rule.interface_should_be_i_prefixed.severity      = error
dotnet_naming_rule.interface_should_be_i_prefixed.symbols       = interface
dotnet_naming_rule.interface_should_be_i_prefixed.style         = i_prefix_style
dotnet_naming_symbols.interface.applicable_kinds                = interface
dotnet_naming_style.i_prefix_style.required_prefix              = I
dotnet_naming_style.i_prefix_style.capitalization               = pascal_case

# Naming: Private fields — Constitution §4.2
dotnet_naming_rule.private_fields_should_be_camel_prefixed.severity  = warning
dotnet_naming_rule.private_fields_should_be_camel_prefixed.symbols   = private_field
dotnet_naming_rule.private_fields_should_be_camel_prefixed.style     = underscore_prefix
dotnet_naming_symbols.private_field.applicable_kinds                  = field
dotnet_naming_symbols.private_field.applicable_accessibilities        = private
dotnet_naming_style.underscore_prefix.required_prefix                 = _
dotnet_naming_style.underscore_prefix.capitalization                  = camel_case

# Naming: Constants — PascalCase
dotnet_naming_rule.constants_should_be_pascal.severity          = warning
dotnet_naming_rule.constants_should_be_pascal.symbols           = constant
dotnet_naming_rule.constants_should_be_pascal.style             = pascal_case_style
dotnet_naming_symbols.constant.applicable_kinds                  = field
dotnet_naming_symbols.constant.required_modifiers                = const
dotnet_naming_style.pascal_case_style.capitalization             = pascal_case

# Code style
csharp_style_var_for_built_in_types                              = true:suggestion
csharp_style_var_when_type_is_apparent                           = true:suggestion
csharp_style_var_elsewhere                                       = true:suggestion

csharp_new_line_before_open_brace                                = all
csharp_new_line_before_else                                      = true
csharp_new_line_before_catch                                     = true
csharp_new_line_before_finally                                   = true
csharp_new_line_before_members_in_object_initializers            = true
csharp_new_line_before_members_in_anonymous_types                = true

csharp_indent_case_contents                                      = true
csharp_indent_switch_labels                                      = true

csharp_space_after_cast                                          = false
csharp_space_before_colon_in_inheritance_clause                  = true
csharp_space_after_colon_in_inheritance_clause                   = true

csharp_preserve_single_line_blocks                               = true
csharp_preserve_single_line_statements                           = false

# Expression-bodied members
csharp_style_expression_bodied_methods                           = when_on_single_line:suggestion
csharp_style_expression_bodied_properties                        = true:suggestion
csharp_style_expression_bodied_constructors                      = false:warning

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check            = true:error
csharp_style_pattern_matching_over_as_with_null_check            = true:error

# Null checking
csharp_style_conditional_delegate_call                           = true:suggestion
dotnet_style_null_propagation                                    = true:warning
dotnet_style_coalesce_expression                                 = true:warning

# Using directives
csharp_using_directive_placement                                 = outside_namespace:error
dotnet_sort_system_directives_first                              = true

# Accessibility modifier
dotnet_style_require_accessibility_modifiers                     = always:warning

# Organize usings
dotnet_separate_import_directive_groups                          = true

# JSON / YAML
[*.{json,yaml,yml}]
indent_size = 2

# XML / csproj
[*.{xml,csproj,props,targets,resx}]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Angular / TypeScript
[*.{ts,html,scss,css}]
indent_size = 2
end_of_line = lf
