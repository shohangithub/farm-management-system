# =============================================================================
# Farm360 AI — .gitignore
# =============================================================================

# Build outputs
bin/
obj/
out/
*.dll
*.exe
*.pdb
*.cache
*.user

# .NET specific
*.suo
*.vs/
.vs/
*.userprefs
*.orig

# NuGet
*.nupkg
*.snupkg
packages/
!**/packages/repositories.config
.nuget/
NuGet.Config

# Entity Framework Migrations (keep source, ignore snapshots from local-only migrations)
# Note: Keep Migrations folder tracked; exclude only generated files

# ASP.NET Core
appsettings.*.json
!appsettings.json
!appsettings.Development.json

# Secrets — NEVER commit secrets
appsettings.Secrets.json
**/secrets.json
**/*.pfx
**/*.p12
**/*.key
**/launchSettings.json

# Docker
*.override.env
.env.local
.env.production

# Logs
logs/
*.log
*.log.*

# Test results & coverage
TestResults/
coverage/
*.trx
*.coverage
*.coveragexml
lcov.info

# IDE — Visual Studio
.vs/
*.rsuser
*.suo
*.vspx
*.sap
*.vcxproj.filters
*.vcxproj.user

# IDE — Rider / JetBrains
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# IDE — VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Node / Angular
node_modules/
dist/
.angular/
.sass-cache/
*.js.map
*.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
!package-lock.json
.npm
.yarn-integrity

# OS
.DS_Store
Thumbs.db
desktop.ini
*.lnk
__MACOSX/

# Azure
.azure/
*.publishsettings
*.pubxml

# Docker
.dockerignore

# Terraform (future)
*.tfstate
*.tfstate.*
.terraform/

# Hangfire Dashboard (not for prod)
hangfire.*.db
